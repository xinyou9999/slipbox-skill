{
  "schema_version": 1,
  "name": "slipbox",
  "version": "0.2.0",
  "description": "Capture reusable Markdown cards, govern tags, retrieve by literal text or tag, and review recently updated cards through an AI agent.",
  "python_requires": ">=3.10",
  "runtime_dependencies": [],
  "entrypoint": "scripts/slipbox.py",
  "instructions": {
    "default": "SKILL.md"
  },
  "default_library": "~/.slipbox",
  "library_environment_variable": "SLIPBOX_HOME",
  "source_of_truth": [
    "cards/*.md",
    "tags.json"
  ],
  "derived_index": "SQLite",
  "maximum_tags_per_card": null,
  "search": "multi_term_body_tag_alias_and_date",
  "semantic_judgment": "host_agent",
  "calls_model_api": false,
  "cross_device_sync": false,
  "hosts": [
    {
      "name": "Codex",
      "status": "documented_untested"
    },
    {
      "name": "Hermes",
      "status": "documented_untested"
    },
    {
      "name": "OpenClaw",
      "status": "documented_untested"
    },
    {
      "name": "WorkBuddy",
      "status": "documented_untested"
    },
    {
      "name": "DeepSeek harness",
      "status": "experimental_untested"
    }
  ],
  "commands": {
    "init": "initialize_library",
    "add": "capture_card",
    "list": "list_cards",
    "search": "local_multi_term_search",
    "show": "read_card",
    "edit": "revise_card",
    "delete": "delete_card_after_confirmation",
    "review": "recently_updated_cards",
    "activity": "existing_note_creation_counts_by_host_local_date",
    "tag-add": "explicitly_create_tag",
    "tag-list": "inspect_vocabulary",
    "tag-merge": "merge_tags_after_confirmation",
    "tag-stats": "tag_usage",
    "tag-update": "update_tag_metadata_if_snapshot_matches",
    "apply-card-tags": "atomically_apply_tag_only_ai_result_if_revision_matches",
    "rebuild-index": "rebuild_derived_index",
    "search-candidates": "bounded_local_or_retrieval",
    "trash-list": "list_recoverable_deleted_cards",
    "restore": "restore_card_if_revision_matches",
    "purge": "permanently_remove_deleted_card_and_history_after_confirmation",
    "restore-version": "restore_text_version_if_revision_matches",
    "history": "list_text_versions",
    "export": "export_selected_context_or_full_backup",
    "import-preview": "preview_local_backup_or_flomo_text_import",
    "import-apply": "apply_digest_checked_non_overwriting_import"
  },
  "documentation": [
    "docs/INSTALL.md",
    "docs/QUICKSTART.md",
    "docs/AI_INSTALL.md",
    "references/tagging-policy.md",
    "references/data-format.md",
    "docs/RECOVERY_AND_PORTABILITY.md"
  ],
  "retrieval": {
    "keyword": "AND across body/canonical tag/exact alias",
    "candidate_command": "search-candidates",
    "candidate_limit": 40,
    "ai": "host model query expansion and bounded candidate reranking",
    "vector_index": false,
    "privacy": "local ordinary retrieval; explicit authorization before sending candidate excerpts to host model",
    "date_bounds": [
      "created-on",
      "created-from",
      "created-to"
    ]
  },
  "recovery": {
    "soft_delete": true,
    "text_history": true,
    "automatic_purge": false
  },
  "portability": {
    "backup": "slipbox_json",
    "selected_context": "markdown",
    "imports": [
      "slipbox_json",
      "flomo_html",
      "flomo_zip_text"
    ],
    "automatic_sync": false
  }
}
